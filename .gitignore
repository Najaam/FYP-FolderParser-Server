# Node modules (NEVER push this)
node_modules/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables (IMPORTANT)
.env
.env.*

# OS files
.DS_Store
Thumbs.db

# IDE / Editor files
.vscode/
.idea/
*.swp

# Build / dist folders
dist/
build/

# Temporary files
tmp/
temp/

# Uploads (since you have uploads folder)
src/uploads/*
!src/uploads/.gitkeep

# Coverage reports
coverage/

# Package lock (optional – depends on team)
# Uncomment if you DON'T want to push it
# package-lock.json

# Misc
*.pid
*.seed
*.pid.lock
# Sandbox dependencies and generated Jest result
sandbox/node_modules/
sandbox/jest-result.json
